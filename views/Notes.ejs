<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Notes</title>
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; max-width: 900px; margin: 40px auto; padding: 0 20px; color: #333; background: #fafafa; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
        h1 { margin: 0; font-size: 28px; font-weight: 700; letter-spacing: -0.5px; }
        .add-btn { background: #222; color: white; text-decoration: none; padding: 10px 20px; border-radius: 6px; font-size: 14px; font-weight: 500; transition: opacity 0.2s; }
        .add-btn:hover { opacity: 0.9; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
        .card { background: white; padding: 24px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); border: 1px solid #eee; transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column; }
        .card:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(0,0,0,0.06); }
        .card h2 { margin: 0 0 10px 0; font-size: 18px; line-height: 1.4; font-weight: 600; }
        .date { font-size: 12px; color: #999; margin-bottom: 12px; font-weight: 500; }
        .preview { color: #666; font-size: 14px; line-height: 1.6; flex-grow: 1; margin-bottom: 24px; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
        .actions { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f5f5f5; padding-top: 16px; margin-top: auto; }
        .read-more { color: #222; text-decoration: none; font-size: 13px; font-weight: 600; }
        .delete-btn { background: none; border: none; color: #dc3545; cursor: pointer; font-size: 13px; padding: 4px 8px; border-radius: 4px; transition: background 0.2s; opacity: 0.8; }
        .delete-btn:hover { background: #fee; opacity: 1; }
        .empty { text-align: center; padding: 80px 0; color: #888; grid-column: 1 / -1; }
        .subtitle { color: #666; margin-top: 5px; font-size: 14px; }
    </style>
</head>
<body>
    <header>
        <div>
            <h1>My Notes</h1>
            <div class="subtitle"><%= notes.length %> note<%= notes.length !== 1 ? 's' : '' %></div>
        </div>
        <a href="/notes/create" class="add-btn">+ New Note</a>
    </header>

    <div class="grid">
        <% if (notes.length > 0) { %>
            <% notes.forEach(note => { %>
                <div class="card" id="note-<%= note._id %>">
                    <div class="date"><%= new Date(note.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                    <h2><%= note.title %></h2>
                    <p class="preview"><%= note.content %></p>
                    <div class="actions">
                        <a href="/notes/<%= note._id %>" class="read-more">Read</a>
                        <button class="delete-btn" onclick="deleteNote('<%= note._id %>')">Delete</button>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="empty">
                <p>No notes yet. Create your first note!</p>
            </div>
        <% } %>
    </div>

    <script>
        async function deleteNote(id) {
            if (!confirm('Are you sure you want to delete this note?')) return;
            
            try {
                const res = await fetch(`/notes/${id}`, { method: 'DELETE' });
                // If successful (ok) or redirected (often happens with simple delete endpoints), reload
                if (res.ok || res.redirected) {
                    const card = document.getElementById(`note-${id}`);
                    if (card) {
                        card.style.opacity = '0';
                        setTimeout(() => location.reload(), 200);
                    } else {
                        location.reload();
                    }
                }
            } catch (err) {
                console.error(err);
                alert('Failed to delete note');
            }
        }
    </script>
</body>
</html>
