<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= note.title %></title>
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px; color: #333; line-height: 1.6; }
        .back-link { display: inline-block; margin-bottom: 20px; color: #666; text-decoration: none; font-size: 14px; }
        .back-link:hover { color: #333; text-decoration: underline; }
        article { background: white; padding: 40px; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); border: 1px solid #eee; }
        h1 { margin-top: 0; font-size: 32px; font-weight: 700; margin-bottom: 10px; }
        .date { color: #888; font-size: 14px; margin-bottom: 30px; border-bottom: 1px solid #eee; padding-bottom: 20px; }
        .content { font-size: 18px; white-space: pre-wrap; color: #444; }
        .actions { margin-top: 40px; border-top: 1px solid #eee; padding-top: 20px; display: flex; gap: 15px; }
        .btn { padding: 8px 16px; border-radius: 4px; text-decoration: none; font-size: 14px; font-weight: 500; cursor: pointer; border: none; }
        .btn-delete { background: #ffebee; color: #c62828; }
        .btn-delete:hover { background: #ffcdd2; }
    </style>
</head>
<body>
    <a href="/notes" class="back-link">← Back to Notes</a>
    
    <article>
        <h1><%= note.title %></h1>
        <div class="date">
            Created on <%= new Date(note.createdAt).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
        </div>
        <div class="content"><%= note.content %></div>

        <div class="actions">
            <button class="btn btn-delete" onclick="deleteNote('<%= note._id %>')">Delete Note</button>
        </div>
    </article>

    <script>
        async function deleteNote(id) {
            if (!confirm('Are you sure you want to delete this note?')) return;
            try {
                const res = await fetch(`/notes/${id}`, { method: 'DELETE' });
                if (res.ok || res.redirected) {
                    window.location.href = '/notes';
                }
            } catch (err) {
                console.error(err);
                alert('Failed to delete note');
            }
        }
    </script>
</body>
</html>
